  "scripts": {
    "clear": "rm -rf build .react-router",
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:network": "react-router dev --host",
    "start": "react-router-serve ./build/server/index.js",
    "format:check": "prettier --check .",
    "format": "prettier --write . --log-level=warn",
    "lint": "react-router typegen && eslint",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run --config vitest.config.ts",
    "precommit": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "prepare": "node -e \"if (process.env.CI) process.exit(0); const { spawnSync } = require('child_process'); const r = spawnSync('lefthook', ['install'], { stdio: 'inherit', shell: true }); process.exit(r.status === null ? 1 : r.status);\""
  },
