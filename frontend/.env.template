# Backend URL.
VITE_BACKEND_URL=

# Google Analytics ID (leave blank for development).
VITE_GOOGLE_ANALYTICS_ID=

# Cloudflare Turnstile site key for sign-up. Leave blank to turn Turnstile off.
# Set it whenever the back-end sets TURNSTILE_SECRET_KEY: the back-end then
# rejects sign-ups without a token. For local testing, Cloudflare's test key
# 1x00000000000000000000AA always passes.
VITE_TURNSTILE_SITE_KEY=

# To show the maintenance page
# MAINTENANCE_ACTIVE=true
